{
  "manifest_version": 3,
  "name": "J-PRO 헤이딜러 쿠키 자동연동기",
  "version": "1.0",
  "description": "헤이딜러 로그인 쿠키를 J-PRO 전산 프로그램으로 1초만에 자동 전송합니다.",
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "J-PRO 헤이딜러 쿠키 연동"
  },
  "background": {
    "service_worker": "background.js"
  }
}

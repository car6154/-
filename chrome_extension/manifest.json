{
  "manifest_version": 3,
  "name": "J-PRO 헤이딜러 & 차얼마 쿠키 자동연동기",
  "version": "1.4",
  "description": "헤이딜러 및 차얼마(오토플러스) 로그인 쿠키를 J-PRO 전산 프로그램으로 실시간 자동 전송합니다.",
  "permissions": [
    "cookies",
    "tabs",
    "alarms",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "*://*.heydealer.com/*",
    "*://heydealer.com/*",
    "*://*.autoplus.co.kr/*",
    "*://autoplus.co.kr/*",
    "*://*.encar.com/*",
    "*://encar.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "J-PRO 헤이딜러 & 차얼마 쿠키 연동"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.heydealer.com/*",
        "*://heydealer.com/*",
        "*://*.autoplus.co.kr/*",
        "*://autoplus.co.kr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}

                    encar_no_acc_avg = int(df_temp[is_no_acc]['판매가'].mean()) if is_no_acc.any() else encar_avg_price
                    encar_acc_avg = int(df_temp[~is_no_acc]['판매가'].mean()) if (~is_no_acc).any() else encar_avg_price
                    acc_gap = encar_no_acc_avg - encar_acc_avg
                    
                    # 옵션 (간단한 선루프 유무)
                    has_sunroof = df_temp['추가옵션'].astype(str).str.contains('선루프')
                    encar_sunroof_avg = int(df_temp[has_sunroof]['판매가'].mean()) if has_sunroof.any() else encar_avg_price
                    encar_no_sunroof_avg = int(df_temp[~has_sunroof]['판매가'].mean()) if (~has_sunroof).any() else encar_avg_price
                    sunroof_gap = encar_sunroof_avg - encar_no_sunroof_avg
                    

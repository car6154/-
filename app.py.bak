            "매입가": st.column_config.NumberColumn("매입가(만)", format="%d"),
            "엔카 링크": st.column_config.LinkColumn("엔카 링크", display_text="🔗 보러가기"),
        }
                
        status_col = out_df['홈페이지상태'].astype(str).str.strip()

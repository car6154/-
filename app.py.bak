                        # 세션 상태에 저장하여 사이드바에 표시
                        st.session_state.hd_target_year = target_year
                        st.session_state.hd_target_mileage = target_mileage
                        st.session_state.hd_target_plate = target_plate
                        
                        if not hd_comp_df.empty:
                            if target_year:
                                hd_same_year = hd_comp_df[hd_comp_df['연식'] == int(target_year)]
                                hd_prev = hd_comp_df[hd_comp_df['연식'] == int(target_year) - 1]
                                hd_next = hd_comp_df[hd_comp_df['연식'] == int(target_year) + 1]
                            else:
                                hd_same_year = hd_comp_df
                                hd_prev = pd.DataFrame()
                                hd_next = pd.DataFrame()
                                
                            # 기준 데이터: 동일 연식 우선, 없으면 전체
                            base_df = hd_same_year if not hd_same_year.empty else hd_comp_df
                            
                            # 1. Polyfit 추세선 기준가 계산
                            if len(base_df) >= 2:
                                z = np.polyfit(base_df['주행거리_num'], base_df['판매가_num'], 1)
                                hd_market_avg = int(np.polyval(z, int(target_mileage) if target_mileage else 50000))
                            else:
                                hd_market_avg = int(base_df['판매가_num'].mean())
                                
                            # 2. 사고/무사고 차이
                            is_no_acc = base_df['사고유무'] == '완전무사고'
                            hd_no_acc_avg = int(base_df[is_no_acc]['판매가_num'].mean()) if is_no_acc.any() else hd_market_avg
                            hd_acc_avg = int(base_df[~is_no_acc]['판매가_num'].mean()) if (~is_no_acc).any() else hd_market_avg
                            
                            # 3. 선루프 유무 차이
                            has_sunroof = base_df['옵션리스트'].apply(lambda x: any('선루프' in opt or '썬루프' in opt for opt in x))
                            hd_sunroof_avg = int(base_df[has_sunroof]['판매가_num'].mean()) if has_sunroof.any() else hd_market_avg
                            hd_no_sunroof_avg = int(base_df[~has_sunroof]['판매가_num'].mean()) if (~has_sunroof).any() else hd_market_avg
                            
                            # 4. 전후 연식
                            prev_year_avg = int(hd_prev['판매가_num'].mean()) if not hd_prev.empty else 0
                            next_year_avg = int(hd_next['판매가_num'].mean()) if not hd_next.empty else 0
                except Exception as e:
                    print(f"Error parsing heydealer market prices: {e}")

            # heydealer_ai.py에서 가져온 함수 실행 (AI가 소매가 직접 추정)
            ai_prompt = extract_car_data_for_ai(
                heydealer_json_str, 
                encar_market_avg=encar_avg_price,
                encar_no_acc=encar_no_acc_avg,
                encar_acc=encar_acc_avg,
                encar_sunroof=encar_sunroof_avg,
                encar_no_sunroof=encar_no_sunroof_avg,
                hd_market_avg=hd_market_avg, 
                hd_no_acc=hd_no_acc_avg, 
                hd_acc=hd_acc_avg, 
                hd_sunroof=hd_sunroof_avg, 
                hd_no_sunroof=hd_no_sunroof_avg, 
                prev_year_avg=prev_year_avg,
                next_year_avg=next_year_avg,
                auction_repairs_json=auction_repairs_json
            )
            with st.expander("생성된 프롬프트 보기"):
                st.code(ai_prompt, language="markdown")
            
            with st.spinner("Gemini AI가 예상 매입가와 마진을 계산 중입니다..."):
                ai_estimate = get_gemini_estimate(ai_prompt)
                
            st.info("🤖 **Gemini AI 매입 견적 결과**")
            st.markdown(ai_estimate)
            
        except Exception as e:
            st.error(f"작업 실패: {str(e)}")

# 강제 리로드 트리거 7